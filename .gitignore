# A whitelist: the working tree also holds gigabytes of downloads, build output, logs, third-party
# clones and files of iOS, none of which belongs in the repository. Nothing is tracked unless it
# is named here.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/docs/
!/xl
!/mkxnuimg.py
!/xnu-build.sh
!/xnu-env.sh
!/xnuloader/
!/qemu/
!/tools/
!/userland/
!/ios165/
!/xnu/
!/xnu-deps/
!/uefi/
!/prebuilt/
!/wifi/

__pycache__/
*~
*.orig
*.rej

/xnuloader/*
!/xnuloader/build.sh
!/xnuloader/efi.h
!/xnuloader/identity.h
!/xnuloader/loader.c
!/xnuloader/mkidentity.py
!/xnuloader/mkpayload.py

/qemu/*
!/qemu/*.sh
!/qemu/*.py

/userland/*
!/userland/build.sh
!/userland/pack-gpu-firmware.sh
!/userland/*.py
!/userland/rc.*
!/userland/com.redwood.*.plist
!/userland/src/
!/userland/libmini/
!/userland/var/

/ios165/*
!/ios165/fetch.sh
!/ios165/*.py

# of xnu-deps only what is ours; setup.sh fetches and builds the rest
/xnu-deps/*
!/xnu-deps/setup.sh
!/xnu-deps/gen-iig-stubs.py
!/xnu-deps/hostinc/
# Optional workspace-local system development headers.
/xnu-deps/hostinc/uuid/
!/xnu-deps/iig-impl/
!/xnu-deps/host/
/xnu-deps/host/*
!/xnu-deps/host/bin/
/xnu-deps/host/bin/*
!/xnu-deps/host/bin/codesign
!/xnu-deps/host/bin/iig
!/xnu-deps/host/bin/install
!/xnu-deps/host/bin/plutil
!/xnu-deps/host/bin/sw_vers
!/xnu-deps/host/bin/xcrun
!/xnu-deps/host/bin/xnu-clang
!/xnu-deps/build/
/xnu-deps/build/*
!/xnu-deps/build/pthread/
/xnu-deps/build/pthread/*
!/xnu-deps/build/pthread/build.sh
!/xnu-deps/build/pthread/inc/
!/xnu-deps/build/lzbitmap/
/xnu-deps/build/lzbitmap/*
!/xnu-deps/build/lzbitmap/unzbm.c
!/xnu-deps/build/lzbitmap/libzbitmap.c
!/xnu-deps/build/lzbitmap/libzbitmap.h

# Optional RAM package-manager/SSH inputs and host shader build outputs
/jb/
/ssh/
/build/

# Reproducible Renoir recovery tools, not downloaded archives
!/recovery/
/recovery/assets/

